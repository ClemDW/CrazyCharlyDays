{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS", // On repasse en CommonJS
    "moduleResolution": "node",
    "outDir": "./dist",
    "rootDir": "./src",
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "strictPropertyInitialization": false,
    "lib": ["esnext", "dom"],
  }
  },
  "include": [
    "src/**/*.ts"
  ]
}